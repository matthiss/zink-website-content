# Zink statisch – Apache/Plesk. HTTPS/HSTS nur aktivieren, wenn Zertifikat steht!
<IfModule mod_rewrite.c>
RewriteEngine On
# Kanonische Domain (ggf. anpassen/aktivieren):
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://www.dienstleistungsservice-zink.de%{REQUEST_URI} [R=301,L]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.dienstleistungsservice-zink.de%{REQUEST_URI} [R=301,L]

# Alte WP-Seiten → neue statische Seiten (301)
RewriteRule ^impressum/?$ /impressum.html [R=301,L]
RewriteRule ^impressum-2/?$ /impressum.html [R=301,L]
RewriteRule ^impressum-3/?$ /impressum.html [R=301,L]
RewriteRule ^datenschutzerkaerung/?$ /datenschutz.html [R=301,L]
RewriteRule ^kontakt/?$ /kontakt.html [R=301,L]
RewriteRule ^startseite/?$ /index.html [R=301,L]
RewriteRule ^leistungen/?$ /leistungen.html [R=301,L]
RewriteRule ^dienstleistungen/?$ /leistungen.html [R=301,L]
RewriteRule ^baumschnitt-und-faellungen/?$ /leistungen.html#baumschnitt [R=301,L,NE]
RewriteRule ^baumschnitt/?$ /leistungen.html#baumschnitt [R=301,L,NE]
# Kaminholz wird nicht mehr angeboten → auf Schwerpunkt Baumschnitt leiten:
RewriteRule ^kaminholz(-lieferservice)?/?$ /leistungen.html#baumschnitt [R=301,L,NE]
RewriteRule ^brennholz/?$ /leistungen.html#baumschnitt [R=301,L,NE]
# Fokus 2026-10: Hausmeister/Bau/Grab entfallen → Schwerpunkt Baumschnitt/Baumpflege.
# (Anker #... werden vom Browser nicht an den Server gesendet – sie wirken nur clientseitig.)
RewriteRule ^hausmeister(service)?/?$ /leistungen.html#baumschnitt [R=301,L,NE]
RewriteRule ^bau(-nebenleistungen|leistungen)?/?$ /leistungen.html#baumschnitt [R=301,L,NE]
RewriteRule ^grabpflege/?$ /leistungen.html#baumschnitt [R=301,L,NE]
RewriteRule ^gartenmoebel-und-spielgeraete-aus-holz/?$ /leistungen.html#holzgestaltung [R=301,L,NE]
RewriteRule ^kreatives-aus-und-mit-holz/?$ /leistungen.html#holzgestaltung [R=301,L,NE]
RewriteRule ^referenzobjekte/?$ /galerie.html [R=301,L]
RewriteRule ^unser-team/?$ /galerie.html [R=301,L]
RewriteRule ^team\.html?$ /galerie.html [R=301,L]

# WP-Angriffsfläche & Feeds → 410 Gone
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php)$ - [G]
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$ - [G]
RewriteRule ^(feed|comments/feed|.*-feed/?)$ - [G]
</IfModule>

# HSTS – erst aktivieren, wenn HTTPS überall funktioniert:
# Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Caching für statische Assets
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType image/jpeg "access plus 90 days"
ExpiresByType image/png "access plus 90 days"
</IfModule>

ErrorDocument 404 /404.html
